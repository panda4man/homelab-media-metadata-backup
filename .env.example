TZ=America/New_York

# Container-internal paths the application itself reads. These must match
# the container-side halves of the volume mounts in compose.yml - leave
# them as-is unless you also change compose.yml.
MEDIA_MOVIES_PATH=/media/movies
MEDIA_TV_PATH=/media/tv

# Host-side paths compose.yml mounts into the container above. These are
# read only by docker compose, never by the application itself.
HOST_MEDIA_MOVIES_PATH=/mnt/user/media/movies
HOST_MEDIA_TV_PATH=/mnt/user/media/tv
HOST_SNAPSHOT_PATH=/mnt/user/appdata/media-inventory/snapshots
HOST_RCLONE_CONFIG_PATH=/mnt/user/appdata/media-inventory/rclone

RADARR_URL=http://radarr:7878
RADARR_API_KEY=

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=

SNAPSHOT_PATH=/data/snapshots
SNAPSHOT_RETENTION=5

MAX_MEDIA_BYTES_DECREASE_PERCENT=5
MAX_MOVIE_DECREASE_PERCENT=5
MAX_EPISODE_DECREASE_PERCENT=5
MAX_FILES_REMOVED=100
MAX_UNMATCHED_PERCENT=5

RCLONE_REMOTE=media-inventory:
